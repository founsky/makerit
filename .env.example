# Supabase — trouvez ces URLs dans : Project Settings > Database > Connection string
# DATABASE_URL : "Transaction" pooler (port 6543) — pour Prisma en production
# DIRECT_URL   : "Direct" connection (port 5432) — pour les migrations Prisma
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"

SESSION_SECRET="change-me-to-a-32-char-random-string"
SESSION_NAME="makerit_session"

# Supabase Storage (optionnel — pour stocker les fichiers STL/images dans le cloud)
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

